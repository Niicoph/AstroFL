---
import background from "../assets/background.svg";
import Button from "./Button/Button";
---

<div
  id="container"
  class="flex flex-col gap-5 justify-center items-center w-full h-full"
>
  <div id="background1" class="bg-indigo-500"></div>
  <div id="background2" class="bg-indigo-500"></div>
  <div id="background3" class="bg-indigo-600"></div>

  <h1 class="text-2xl font-semibold">Astro</h1>
  <p class="text-xl">This is a very basic astro scaffold</p>
  <Button client:visible />
</div>

<style>
  #background1 {
    position: fixed;
    top: 0;
    left: 0;
    width: 40%;
    height: 40%;
    z-index: -1;
    animation: movement 10s infinite ease-in-out;
    filter: blur(100px);
  }
  #background2 {
    position: fixed;
    top: 40;
    right: 0;
    width: 30%;
    height: 50%;
    z-index: -1;
    animation: movement 10s infinite ease-in-out;
    filter: blur(100px);
  }
  #background3 {
    position: fixed;
    left: 0;
    bottom: 0;
    width: 30%;
    height: 30%;
    z-index: -1;
    animation: movement 3s infinite ease-in-out;
    filter: blur(100px);
  }

  @keyframes movement {
    0% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(100px, 10px, 200px, 500px);
    }
    100% {
      transform: translate(0, 0);
    }
  }

  main {
    height: 100%;
    display: flex;
    justify-content: center;
  }
</style>
