---
import background from "../assets/background.svg";
import Button from "./Button/Button";
---

<div
  id="container"
  class="flex flex-col gap-5 justify-center items-center w-full h-full"
>
  <img id="background" src={background.src} alt="" fetchpriority="high" />
  <h1 class="text-2xl font-semibold">Astro</h1>
  <p class="text-xl">This is a very basic astro scaffold</p>
  <Button client:visible />
</div>

<style>
  #background {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    filter: blur(100px);
  }

  main {
    height: 100%;
    display: flex;
    justify-content: center;
  }
</style>
